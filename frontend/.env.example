# Base URL of the self-hosted vlr-api (server-side fetch only — the browser
# never calls this directly, so no CORS / public exposure needed).
# Co-located on LXC 289; defaults to this if unset.
VLR_API_BASE=http://127.0.0.1:8000/api/v1
# Optional separate prediction-record API for isolated previews.
# VLR_PREDICTIONS_API_BASE=http://127.0.0.1:8200/api/v1
