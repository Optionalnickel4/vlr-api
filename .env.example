# copy to .env and adjust. chmod 600.
VLR_REDIS_URL=redis://localhost:6379/0
VLR_DATABASE_URL=postgresql+asyncpg://vlr:CHANGEME@localhost:5432/vlr
VLR_USER_AGENT=vlr-api/0.1 (self-hosted; +https://jushosting.dev)
VLR_MIN_REQUEST_INTERVAL=1.5
VLR_ENABLE_SCHEDULER=true

# Predictions are opt-in. All credentials belong only on the backend.
VLR_PREDICTIONS_ENABLED=false
VLR_PREDICTIONS_SOURCE_API_URL=
VLR_PREDICTIONS_BATCH_SIZE=3
VLR_OPENCLAW_BASE_URL=https://openclaw.jushosting.dev
VLR_OPENCLAW_AGENT_ID=val-predictions
VLR_OPENCLAW_GATEWAY_TOKEN=
VLR_OPENCLAW_ACCESS_CLIENT_ID=
VLR_OPENCLAW_ACCESS_CLIENT_SECRET=
VLR_OPENCLAW_TIMEOUT=60
